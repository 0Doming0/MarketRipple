---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { authorName, authorLinkedIn, authorGitHub } from '../consts'
import SchemaAuthor from '../components/SchemaAuthor.astro'
import AuthorBox from '../components/AuthorBox.astro'


import Comments from '../components/Comments.astro';
import NewsletterBox from '../components/NewsletterBox.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, categories, tags, lang, postUrl, pubDate, updatedDate, heroImageData, heroImage, commentCTA } = Astro.props;
const titleLength = title.length;
const minFontSize = 1.5;
const maxFontSize = 3.2;
const inverseRatio = 1 - Math.min(Math.max(titleLength / 80, 0), 1);
const adaptiveSize = minFontSize + inverseRatio * (maxFontSize - minFontSize);
const TitleSize = `${Math.min(maxFontSize, Math.max(minFontSize, adaptiveSize))}rem`;
console.log (heroImageData)
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} tags={tags} image={heroImageData.src}, lang={lang} />

        <SchemaAuthor 
            title={title}
            description={description}
            pubDate={pubDate}
            url={postUrl}
            image={heroImageData.src}
            authorName={authorName}
            authorLinkedin={authorLinkedIn}
			authorGitHub={authorGitHub} />
    
        

		<meta name="robots" content="max-image-preview:large" />
		{categories && categories.map((cat) => (
	        <meta property="article:section" content={cat} />
        ))}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: calc(100% + 2em);
				
			}
			.hero-image img {
				display: block;
				position: relative;
				
				margin: 0 auto;
				border-radius: 4px;
				box-shadow: var(--box-shadow);
				max-width: 100%;
				height: auto;
			}
			.prose {
		
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 0;
				border: 2px;
			}
			.title {
				margin-bottom: 0.5em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.comment-cta {
				background: var(--surface);
				padding: 1.5em;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
				max-width: calc(100% - 2em);
				text-align: center;
			}
			.comment-cta-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.75em;
			}
			.comment-cta-text {
				margin: 0;
				font-size: 1rem;
				
			}
			.comment-cta-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.75em 1.25em;
				border-radius: 9999px;
				background: var(--color-primary);
				color: white;
				text-decoration: none;
				font-weight: 700;
				transition: transform 0.2s ease;
			}
			.comment-cta-link:hover {
				transform: translateY(-1px);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
			    <div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1 class=".title" style={{ fontSize: TitleSize, fontWeight: '700' }}>{title}</h1>
					
				</div>
				<p class = 'ml-[1em] description text-gray-600'>{description}</p>
				<hr class = 'ml-[1em]' />
				<br>
				<div class="hero-image">
					{heroImageData && <Image width={heroImageData.width} height={heroImageData.height} src={heroImageData.src} alt={heroImageData.alt} loading="eager" fetchpriority="high" />}
				</div>
				
				<div class="prose">
				    <div class="mb-4">
					  {categories?.length > 0 && (
  <div class="flex flex-wrap gap-2">
    {categories.map((cat) => (
      <span class="inline-flex items-center rounded border border-emerald-800/60 bg-gray-100 px-2.5 py-1 text-xs font-mono uppercase tracking-wider text-emerald-400">
        {cat}
      </span>
    ))}
  </div>
)}
				    </div>
					
					
					<slot />
				</div>
			</article>
		</main>
		<AuthorBox />
        <hr class = 'big-separator'>
        <section class="comment-cta">
          <div class="comment-cta-box">
            <p class="comment-cta-text" set:html={commentCTA}></p>
            
          </div>
        </section>

        <div id="comment-section">
          <Comments />
        </div>

		<NewsletterBox />
		<Footer />
