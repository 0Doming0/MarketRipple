---
// src/components/NewsletterBox.astro
---

<div class="my-10 p-6 bg-slate-900 border border-slate-800 rounded-xl text-center max-w-2xl mx-auto shadow-lg">
  <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-500/10 text-emerald-400 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </div>
  
  <h3 class="text-xl font-bold text-white mb-2">Join the MarketRipple Insiders</h3>
  <p class="text-slate-400 text-sm mb-6 max-w-md mx-auto">
    Get exclusive deep dives into elite wealth, market anomalies, and finance trends direct to your inbox.
  </p>
  
  <!-- Cole o SEU link do Substack no href abaixo -->
  <a 
    href="https://marketripple.substack.com" 
    target="_blank" 
    rel="noopener noreferrer"
    class="inline-block w-full sm:w-auto bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold px-8 py-3 rounded-lg transition-colors shadow-md shadow-emerald-500/10"
  >
    Subscribe for Free
  </a>
</div>