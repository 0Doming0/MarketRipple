---
interface Props {
  bio?: string;
}
import { Image } from 'astro:assets';
import { authorName, authorLinkedIn, authorGitHub, authorTwitter } from '../consts'
import ImageProfile from '../assets/1782849625016.png'
const { 
  bio = "Developer and market specialist at Market Ripple News, analyzing on-chain data, cryptocurrency trends, and financial ecosystems..",  
} = Astro.props;
---

<div class="my-2 p-6 backdrop-blur-sm transition-all hover:border-emerald-500/30">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 text-center sm:text-left">
    
    {/* Avatar / Iniciais do Autor */}
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-emerald-950 border border-emerald-500/20 text-emerald-400 font-bold text-lg shadow-sm shadow-emerald-500/10">
      {ImageProfile && <Image class="rounded-full" width={ImageProfile.width} height={ImageProfile.height} src={ImageProfile.src} alt="Author" />}
    </div>
    
    {/* Informações */}
    <div class="space-y-2">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Escrito por</span>
        <h3 class="text-base font-bold text-black-900 mt-0.5">{authorName}</h3>
      </div>
      
      <p class="text-sm text-zinc-400 leading-relaxed max-w-2xl">
        {bio}
      </p>
      
      {/* Redes Sociais de Validação (Crucial para E-E-A-T) */}
      <div class="flex justify-center sm:justify-start gap-3 pt-1 text-xs text-zinc-500">
        {authorLinkedIn && (
          <a href={authorLinkedIn} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>LinkedIn</span> ↗
          </a>
        )}
        {authorGitHub && (
          <a href={authorGitHub} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>GitHub</span> ↗
          </a>
        )}
        {authorTwitter && (
          <a href={authorTwitter} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>X / Twitter</span> ↗
          </a>
        )}
      </div>
    </div>
  </div>
</div>