---
interface Props {
  name: string;
  bio?: string;
  linkedin?: string;
  github?: string;
  twitter?: string;
}

const { 
  name, 
  bio = "Desenvolvedor e especialista de mercado na MarketRipple, analisando dados on-chain, tendências de criptomoedas e ecossistemas financeiros.", 
  linkedin, 
  github,
  twitter 
} = Astro.props;
---

<div class="mt-12 p-6 rounded-xl border border-zinc-800 bg-zinc-900/50 backdrop-blur-sm transition-all hover:border-emerald-500/30">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 text-center sm:text-left">
    
    {/* Avatar / Iniciais do Autor */}
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-emerald-950 border border-emerald-500/20 text-emerald-400 font-bold text-lg shadow-sm shadow-emerald-500/10">
      {name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()}
    </div>
    
    {/* Informações */}
    <div class="space-y-2">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Escrito por</span>
        <h3 class="text-base font-bold text-zinc-100 mt-0.5">{name}</h3>
      </div>
      
      <p class="text-sm text-zinc-400 leading-relaxed max-w-2xl">
        {bio}
      </p>
      
      {/* Redes Sociais de Validação (Crucial para E-E-A-T) */}
      <div class="flex justify-center sm:justify-start gap-3 pt-1 text-xs text-zinc-500">
        {linkedin && (
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>LinkedIn</span> ↗
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>GitHub</span> ↗
          </a>
        )}
        {twitter && (
          <a href={twitter} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>X / Twitter</span> ↗
          </a>
        )}
      </div>
    </div>
  </div>
</div>