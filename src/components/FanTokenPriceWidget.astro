---
// Component to fetch and display live fan token prices from CoinGecko
interface Props {
  tokens?: Array<{ name: string; id: string; symbol: string }>;
}

const defaultTokens = [
  { name: "Argentina Fan Token", id: "argentina-fan-token", symbol: "ARG" },
  { name: "Brazil Fan Token", id: "fan-token-barcelona", symbol: "BAR" },
];

const { tokens = defaultTokens } = Astro.props;

let priceData: any[] = [];

try {
  const tokenIds = tokens.map((t) => t.id).join(",");
  const response = await fetch(
    `https://api.coingecko.com/api/v3/simple/price?ids=${tokenIds}&vs_currencies=usd&include_market_cap=true&include_24h_change=true`
  );
  const data = await response.json();

  priceData = tokens.map((token) => ({
    ...token,
    price: data[token.id]?.usd || "N/A",
    change24h: data[token.id]?.usd_24h_change || null,
    marketCap: data[token.id]?.usd_market_cap || null,
  }));
} catch (error) {
  console.error("Error fetching fan token prices:", error);
}
---

<div class="fan-token-widget">
  <h3>💰 Live Fan Token Prices</h3>
  <p class="widget-subtitle">Current market data from CoinGecko (updated every 5 minutes)</p>

  <div class="token-grid">
    {
      priceData.length > 0 ? (
        priceData.map((token) => (
          <div class="token-card">
            <div class="token-header">
              <strong>{token.name}</strong>
              <span class="symbol">{token.symbol}</span>
            </div>

            <div class="token-price">
              {typeof token.price === "number" ? `$${token.price.toFixed(4)}` : token.price}
            </div>

            {token.change24h !== null && (
              <div class={`token-change ${token.change24h >= 0 ? "positive" : "negative"}`}>
                {token.change24h >= 0 ? "↑" : "↓"} {Math.abs(token.change24h).toFixed(2)}% (24h)
              </div>
            )}

            {token.marketCap && (
              <div class="token-marketcap">
                Cap: ${(token.marketCap / 1000000).toFixed(2)}M
              </div>
            )}
          </div>
        ))
      ) : (
        <p class="error-message">Unable to fetch live prices. Please refresh the page.</p>
      )
    }
  </div>
</div>

<style>
  .fan-token-widget {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12px;
    padding: 24px;
    margin: 32px 0;
    color: white;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .fan-token-widget h3 {
    margin: 0 0 8px 0;
    font-size: 1.5rem;
  }

  .widget-subtitle {
    margin: 0 0 20px 0;
    opacity: 0.9;
    font-size: 0.9rem;
  }

  .token-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .token-card {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    padding: 16px;
    backdrop-filter: blur(10px);
  }

  .token-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .symbol {
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .token-price {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .token-change {
    font-size: 0.9rem;
    margin-bottom: 8px;
  }

  .token-change.positive {
    color: #4ade80;
  }

  .token-change.negative {
    color: #ef4444;
  }

  .token-marketcap {
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .error-message {
    text-align: center;
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .fan-token-widget {
      padding: 16px;
    }

    .token-grid {
      grid-template-columns: 1fr;
    }

    .fan-token-widget h3 {
      font-size: 1.25rem;
    }
  }
</style>
