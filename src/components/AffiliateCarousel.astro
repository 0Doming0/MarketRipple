---
// Animated Carousel Component for Affiliate Images
// Usage: <AffiliateCarousel items={[{image: ImageMetadata, link: string, title: string}]} />

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CarouselItem {
  image: ImageMetadata | string;
  link: string;
  title: string;
  altText?: string;
}

interface Props {
  items: CarouselItem[];
  autoplayInterval?: number; // milliseconds
  width?: number; // custom width in pixels (optional, default responsive)
  height?: number; // custom height in pixels (optional, default 16:9 aspect ratio)
}

const { 
  items = [], 
  autoplayInterval = 5000,
  width = undefined,
  height = undefined
} = Astro.props;

// Default aspect ratio: 960x1320 (0.727)
const DEFAULT_ASPECT_RATIO = 960 / 1320;

// Calculate aspect ratio if custom dimensions provided
const customStyle = width && height 
  ? `--carousel-width: ${width}px; --carousel-height: ${height}px; --carousel-aspect-ratio: ${width / height};`
  : `--carousel-aspect-ratio: ${DEFAULT_ASPECT_RATIO};`;

// Generate unique IDs for multiple carousels on same page
const carouselId = Math.random().toString(36).substring(7);
---

<div class="affiliate-carousel" data-carousel-id={carouselId} style={customStyle}>
  <div class="carousel-container">
    <div class="carousel-track" data-track={carouselId}>
      {items.map((item, index) => (
        <div class="carousel-slide" data-slide-index={index}>
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="carousel-link" title={item.title || item.altText}>
            {typeof item.image === 'string' ? (
              <img 
                src={item.image}
                alt={item.altText || item.title}
                class="carousel-image"
                loading="lazy"
              />
            ) : (
              <Image 
                src={item.image}
                alt={item.altText || item.title}
                class="carousel-image"
                widths={[640, 1280]}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 1024px, 1280px"
                loading="lazy"
                quality="high"
              />
            )}
            <div class="carousel-overlay">
              <span class="carousel-cta">Open →</span>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- Navigation Buttons -->
    <button class="carousel-nav carousel-nav-prev" data-carousel={carouselId} aria-label="Previous slide">
      ←
    </button>
    <button class="carousel-nav carousel-nav-next" data-carousel={carouselId} aria-label="Next slide">
      →
    </button>

    <!-- Indicators/Dots -->
    <div class="carousel-indicators">
      {items.map((_, index) => (
        <button 
          class="carousel-dot" 
          data-carousel={carouselId}
          data-slide={index}
          aria-label={`Go to slide ${index + 1}`}
          class:list={[index === 0 && 'active']}
        />
      ))}
    </div>
  </div>
</div>

<script define:vars={{ carouselId, autoplayInterval, itemCount: items.length }}>
  class AffiliateCarousel {
    constructor(id, interval, count) {
      this.id = id;
      this.interval = interval;
      this.itemCount = count;
      this.currentIndex = 0;
      this.autoplayTimeout = null;
      this.isTransitioning = false;

      this.container = document.querySelector(`[data-carousel-id="${id}"]`);
      this.track = document.querySelector(`[data-track="${id}"]`);
      
      if (!this.container || !this.track) return;

      this.initializeCarousel();
    }

    initializeCarousel() {
      // Previous button
      const prevBtn = this.container.querySelector(`[data-carousel="${this.id}"].carousel-nav-prev`);
      if (prevBtn) {
        prevBtn.addEventListener('click', () => this.previous());
      }

      // Next button
      const nextBtn = this.container.querySelector(`[data-carousel="${this.id}"].carousel-nav-next`);
      if (nextBtn) {
        nextBtn.addEventListener('click', () => this.next());
      }

      // Dot indicators
      const dots = this.container.querySelectorAll(`[data-carousel="${this.id}"].carousel-dot`);
      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const slideIndex = parseInt(e.target.dataset.slide);
          this.goToSlide(slideIndex);
        });
      });

      // Pause autoplay on hover
      this.container.addEventListener('mouseenter', () => this.stopAutoplay());
      this.container.addEventListener('mouseleave', () => this.startAutoplay());

      // Touch support
      let touchStartX = 0;
      this.track.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      });

      this.track.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        if (touchStartX - touchEndX > 50) {
          this.next();
        } else if (touchEndX - touchStartX > 50) {
          this.previous();
        }
      });

      this.startAutoplay();
    }

    goToSlide(index) {
      if (this.isTransitioning || index === this.currentIndex) return;
      
      this.isTransitioning = true;
      this.currentIndex = index;

      const offset = -index * 100;
      this.track.style.transform = `translateX(${offset}%)`;

      // Update active dot
      const dots = this.container.querySelectorAll(`[data-carousel="${this.id}"].carousel-dot`);
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      setTimeout(() => {
        this.isTransitioning = false;
      }, 500);

      this.resetAutoplay();
    }

    next() {
      const nextIndex = (this.currentIndex + 1) % this.itemCount;
      this.goToSlide(nextIndex);
    }

    previous() {
      const prevIndex = (this.currentIndex - 1 + this.itemCount) % this.itemCount;
      this.goToSlide(prevIndex);
    }

    startAutoplay() {
      if (this.autoplayTimeout) return;
      
      this.autoplayTimeout = setInterval(() => {
        this.next();
      }, this.interval);
    }

    stopAutoplay() {
      if (this.autoplayTimeout) {
        clearInterval(this.autoplayTimeout);
        this.autoplayTimeout = null;
      }
    }

    resetAutoplay() {
      this.stopAutoplay();
      this.startAutoplay();
    }
  }

  // Initialize carousel when DOM is ready
  const initCarousel = () => {
    new AffiliateCarousel(carouselId, autoplayInterval, itemCount);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
</script>

<style>
  .affiliate-carousel {
    margin: 32px 0;
    width: 100%;
  }

  .carousel-container {
    position: relative;
    width: var(--carousel-width, 100%);
    max-width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #f3f4f6;
    aspect-ratio: var(--carousel-aspect-ratio, 960 / 1320);
    height: var(--carousel-height, auto);
  }

  .carousel-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .carousel-slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-link {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }

  .carousel-link:hover .carousel-image {
    transform: scale(1.05);
  }

  .carousel-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease-in-out;
  }

  .carousel-link:hover .carousel-overlay {
    background: rgba(0, 0, 0, 0.4);
  }

  .carousel-cta {
    color: white;
    font-size: 1.2rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .carousel-link:hover .carousel-cta {
    opacity: 1;
  }

  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    color: #333;
    font-size: 1.5rem;
    font-weight: bold;
    padding: 12px 16px;
    cursor: pointer;
    border-radius: 6px;
    z-index: 10;
    transition: all 0.3s ease-in-out;
  }

  .carousel-nav:hover {
    background: rgba(255, 255, 255, 1);
    transform: translateY(-50%) scale(1.1);
  }

  .carousel-nav-prev {
    left: 16px;
  }

  .carousel-nav-next {
    right: 16px;
  }

  .carousel-indicators {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.6);
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.6);
  }

  .carousel-dot.active {
    background: white;
    border-color: white;
    transform: scale(1.2);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .carousel-container {
      /* Keep the same aspect ratio (960/1320) on mobile */
      aspect-ratio: var(--carousel-aspect-ratio, 960 / 1320);
    }

    .carousel-nav {
      padding: 8px 12px;
      font-size: 1.2rem;
    }

    .carousel-nav-prev {
      left: 8px;
    }

    .carousel-nav-next {
      right: 8px;
    }

    .carousel-cta {
      font-size: 1rem;
    }

    .carousel-indicators {
      bottom: 12px;
      gap: 6px;
    }

    .carousel-dot {
      width: 8px;
      height: 8px;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .carousel-nav {
      background: rgba(50, 50, 50, 0.9);
      color: #fff;
    }

    .carousel-nav:hover {
      background: rgba(50, 50, 50, 1);
    }

    .carousel-container {
      background: #1f2937;
    }
  }
</style>
