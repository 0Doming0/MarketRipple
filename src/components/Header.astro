---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main Navigation" class="-ml-4">
	
	<a href="/" class="flex items-center gap-2.5 no-underline group select-none"
	aria-label="MarketRipple - Go to homepage"
>
  <svg 
    class="w-8 h-8 text-cyan-500 transition-transform duration-300 group-hover:scale-105" 
    viewBox="0 0 32 32" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
  >
    <path 
      d="M4 22C8 17 14 17 18 22" 
      stroke="currentColor" 
      class="text-slate-800 dark:text-slate-200"
      stroke-width="3" 
      stroke-linecap="round"
    />
    <path 
      d="M9 15C13.5 9.5 20.5 9.5 25 15" 
      stroke="currentColor" 
      stroke-width="3.5" 
      stroke-linecap="round"
    />
    <path 
      d="M14 8C17 4 23 4 26 8" 
      stroke="#10B981" 
      stroke-width="3" 
      stroke-linecap="round"
    />
    <circle cx="26" cy="8" r="1.5" fill="#10B981" />
  </svg>

  <span class="flex items-center -ml-2 text-md tracking-tight font-heading">
    <span class="font-extrabold text-black ">Market</span>
    <span class="font-light text-cyan-600 dark:text-cyan-400">Ripple</span>
  </span>
</a>
		<div class="internal-links">
			<HeaderLink href="/blog" aria-label="Go to the blog articles section">Blog</HeaderLink>
			<HeaderLink href="/about" aria-label="Learn more about MarketRipple">About</HeaderLink>
		</div>
		</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
