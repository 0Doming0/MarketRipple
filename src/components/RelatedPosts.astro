---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  currentSlug: string;
  currentTags: string[];
  maxResults?: number;
}

const { currentSlug, currentTags, maxResults = 4 } = Astro.props;

// 1. Buscar todos os posts da coleção de blog (filtramos rascunhos se houver)
const allPosts = await getCollection('blog');

// 2. Filtrar e pontuar posts por relevância baseada em tags compartilhadas
const relatedPosts = allPosts
  .filter(post => post.data.postUrl !== currentSlug) // Remove o post atual
  .map(post => { console.log (post.data.postUrl)
    // Calcula quantos elementos batem na array de tags
    const sharedTags = post.data.tags.filter(tag => currentTags.includes(tag));
    return { post, score: sharedTags.length };
  })
  .filter(item => item.score > 0) // Apenas posts que têm pelo menos uma tag em comum
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()) // Score ou Data
  .slice(0, maxResults)
  .map(item => item.post);
---

{relatedPosts.length > 0 && (
  <div class="related-posts-container my-8 border-t border-b border-emerald-800/40 py-6 bg-emerald-950/5 px-4">
    <p class="text-xs uppercase tracking-wider text-emerald-400 font-semibold mb-4">
      Leia a seguir para dominar o mercado:
    </p>
    <div class="carousel-container relative">
  <div 
    id="carousel-track"
    class="flex overflow-x-auto gap-4 pb-2 snap-x snap-mandatory scrollbar-none scroll-smooth"
  >
    {relatedPosts.map(post => (
      <a 
        href={`${post.data.postUrl}/`} 
        class="group flex flex-col gap-4 no-underline p-3 rounded-lg hover:bg-emerald-900/10 transition-colors duration-200 border border-transparent hover:border-emerald-500/20 w-[280px] sm:w-[320px] flex-shrink-0 snap-start"
      >
        {post.data.heroImageData && (
          <div class="w-full h-40 overflow-hidden rounded-md flex-shrink-0">
            <Image 
              src={post.data.heroImageData.src} 
              alt={post.data.title}
              width={1200}
              height={675}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
        )}
        <div class="flex flex-col justify-center">
          <h4 class="text-base font-bold text-slate-700 group-hover:text-emerald-400 transition-colors line-clamp-2 my-0 leading-snug">
            {post.data.title}
          </h4>
          <p class="text-xs text-slate-400 mt-1 line-clamp-1 my-0">
            {post.data.description}
          </p>
        </div>
      </a>
      
    ))}
  </div>
</div>

<script>
  const track = document.getElementById('carousel-track');
  
  if (track) {
    const intervalTime = 4000; // Tempo de rotação (4 segundos)
    let autoScrollInterval: number;

    const startAutoScroll = () => {
      autoScrollInterval = setInterval(() => {
        const maxScrollLeft = track.scrollWidth - track.clientWidth;
        
        // Se chegou ao fim, volta pro início, caso contrário avança a largura de um item
        if (track.scrollLeft >= maxScrollLeft - 5) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          // Pega a largura do primeiro elemento + o gap (gap-4 = 16px)
          const itemWidth = (track.firstElementChild?.clientWidth || 280) + 16;
          track.scrollBy({ left: itemWidth, behavior: 'smooth' });
        }
      }, intervalTime);
    };

    const stopAutoScroll = () => {
      clearInterval(autoScrollInterval);
    };

    // Inicia o carrossel automático
    startAutoScroll();

    // Pausa quando o usuário interage (evita pular telas enquanto lê)
    track.addEventListener('mouseenter', stopAutoScroll);
    track.addEventListener('mouseleave', startAutoScroll);
    track.addEventListener('touchstart', stopAutoScroll, { passive: true });
    track.addEventListener('touchend', startAutoScroll, { passive: true });
  }
</script>
  </div>
)}