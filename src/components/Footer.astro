---
const currentYear = new Date().getFullYear();

interface Props {
  sources?: Array<{ title: string; url: string }>;
}

const { sources } = Astro.props;
---

<footer class="site-footer bg-slate-900 text-slate-400 border-t border-slate-800 py-12 px-6">
  {sources && sources.length > 0 && (
    <div class="sources-section class-dark-theme-esmeralda">
      <h3 class="text-lg font-bold text-white mb-2">📊 Sources and Factual Data</h3>
      <ul class="space-y-1 text-sm text-gray-400">
        {sources.map(source => (
          <li>
            <a href={source.url} rel="dofollow" target="_blank" class="hover:text-emerald-300 underline">
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
  <br>
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <div>
      <h3 class="text-white font-bold mb-4 text-lg">Market Ripple News</h3>
      <p class="text-sm mb-4">Empowering Web3 and crypto adoption through independent education and market insights.</p>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs">
        <a href="/about" class="hover:text-emerald-400 transition">About Us</a>
        <a href="/contact" class="hover:text-emerald-400 transition">Contact</a>
        <a href="/privacy-policy" class="hover:text-emerald-400 transition">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-emerald-400 transition">Terms of Service</a>
      </div>
    </div>

    <div class="text-xs space-y-2 leading-relaxed">
      <p class="font-semibold text-slate-300 uppercase tracking-wider">Financial Disclaimer</p>
      <p>The content provided on this website is for informational and educational purposes only. It should not be considered financial, investment, or legal advice. Cryptocurrency trading and investing carry high risks; always do your own research (DYOR).</p>
    </div>

    <div class="text-xs space-y-2 leading-relaxed">
      <p class="font-semibold text-slate-300 uppercase tracking-wider">Editorial Transparency</p>
      <p>Advertising and sponsored content are always clearly indicated. We disclose any financial or affiliate interests in services or platforms reviewed on our pages.</p>
    </div>

  </div>

  <div class="max-w-6xl mx-auto mt-8 pt-8 border-t border-slate-800 text-center text-xs">
    <p>&copy; {currentYear} Market Ripple News Media. All rights reserved. Content monitored for accuracy and quality.</p>
  </div>
</footer>