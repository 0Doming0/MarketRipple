---
interface TimelineEvent {
  year: string;
  title: string;
  description: string;
}

interface Props {
  events: TimelineEvent[];
  heading?: string;
  subtitle?: string;
}

const {
  events = [],
  heading = "Musk Crypto Timeline",
  subtitle = "A fast evidence-based view of how Bitcoin, Ethereum and Dogecoin became attached to Elon Musk’s public crypto identity.",
} = Astro.props;
---

<section class="my-10 overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 shadow-2xl shadow-black/20">
  <div class="border-b border-white/10 bg-gradient-to-r from-slate-900 via-slate-950 to-black p-6 md:p-8">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.25em] text-yellow-400">
      Interactive timeline
    </p>
    <h3 class="m-0 text-2xl font-black tracking-tight text-white md:text-3xl">
      {heading}
    </h3>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 md:text-base">
      {subtitle}
    </p>
  </div>

  <div class="relative p-5 md:p-8">
    <div class="absolute bottom-8 left-8 top-8 hidden w-px bg-gradient-to-b from-yellow-400/70 via-emerald-400/40 to-transparent md:block"></div>

    <div class="grid gap-4">
      {events.map((event, index) => (
        <article class="group relative rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-yellow-400/40 hover:bg-white/[0.06] md:ml-8">
          <div class="absolute -left-[2.35rem] top-6 hidden h-4 w-4 rounded-full border-2 border-slate-950 bg-yellow-400 shadow-lg shadow-yellow-500/30 md:block"></div>

          <div class="flex flex-col gap-3 md:flex-row md:items-start md:gap-5">
            <div class="shrink-0">
              <span class="inline-flex rounded-full border border-yellow-400/30 bg-yellow-400/10 px-3 py-1 text-sm font-bold text-yellow-300">
                {event.year}
              </span>
            </div>

            <div>
              <h4 class="m-0 text-lg font-bold text-white md:text-xl">
                {event.title}
              </h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-300 md:text-base">
                {event.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
